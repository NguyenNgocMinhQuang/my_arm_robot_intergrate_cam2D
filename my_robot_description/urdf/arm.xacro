<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="pre_base_link">
        <visual>
                <geometry>
                    <mesh filename="file://$(find my_robot_description)/meshes/g_shape_base_v2_0/visual/base_link.dae"/>
                </geometry>
                <origin xyz="0.0 0 -0.03" rpy="0 0 ${pi/2}"/>
            </visual>
            <collision>
                <geometry>
                    <box size="0.105 0.14 0.02"/>
                </geometry>
                <origin xyz="0.0 0.0 -0.015" rpy="0 0 0"/>
            </collision>
    </link>
    <link name="base_link">
        <visual>
        <geometry>
          <mesh filename="file://$(find my_robot_description)/meshes/mycobot_280/visual/link1.dae"/>
        </geometry>
        <origin xyz="0.0 0 0" rpy="0 0 ${-pi/2}"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.08 0.12 0.075"/>
        </geometry>
        <origin xyz="0.0 -0.01 0.034" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="shoulder_link">
        <visual>
        <geometry>
          <mesh filename="file://$(find my_robot_description)/meshes/mycobot_280/visual/link2.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.06096" rpy="0 0 ${-pi/2}"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.025" length="0.085"/>
        </geometry>
        <origin xyz="0.0 0 -0.02" rpy="0 0 ${-pi/2}"/>
      </collision>
    </link>
    
    <link name="arm_link">
        <visual>
        <geometry>
          <mesh filename="file://$(find my_robot_description)/meshes/mycobot_280/visual/link3.dae"/>
        </geometry>
        <origin xyz="0.0 0 0.03256" rpy="0 ${-pi/2} 0"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.025" length="0.15"/>
        </geometry>
        <origin xyz="-0.058 0 0.059" rpy="0 ${-pi/2} 0"/>
      </collision>
    </link>
    
    <link name="elbow_link">
        <visual>
        <geometry>
          <mesh filename="file://$(find my_robot_description)/meshes/mycobot_280/visual/link4.dae"/>
        </geometry>
        <origin xyz="0.0 0 0.03056" rpy="0 ${-pi/2} 0"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.025" length="0.125"/>
        </geometry>
        <origin xyz="-0.05 0 0.0" rpy="0 ${-pi/2} 0"/>
      </collision>
    </link>

    <link name="forearm_link">
        <visual>
        <geometry>
          <mesh filename="file://$(find my_robot_description)/meshes/mycobot_280/visual/link5.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.03356" rpy="${-pi/2} 0 0"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.03 0.035 0.05"/>
        </geometry>
        <origin xyz="0.0 0 -0.005" rpy="0 0.0 0"/>
      </collision>
    </link>

    <link name="wrist_link">
        <visual>
        <geometry>
          <mesh filename="file://$(find my_robot_description)/meshes/mycobot_280/visual/link6.dae"/>
        </geometry>
        <origin xyz="0 0.00 -0.038" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.025" length="0.06"/>
        </geometry>
        <origin xyz="0 0.00 0.0" rpy="${-pi/2} 0 0"/>
      </collision>
    </link>

    <link name="hand_link">
        <visual>
        <geometry>
          <mesh filename="file://$(find my_robot_description)/meshes/mycobot_280/visual/link7.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.02" length="0.02"/>
        </geometry>
        <origin xyz="0 0.00 0.0" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="tool_link">
    </link>

    <joint name="joint0" type="fixed">
        <parent link="pre_base_link" />
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="joint1" type="revolute">
        <parent link="base_link" />
        <child link="shoulder_link"/>
        <origin xyz="0 0 0.13156" rpy="0 0 ${pi/2}"/>
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="1.0" lower="-2.879793" upper="2.879793" />
    </joint>

    <joint name="joint2" type="revolute">
        <parent link="shoulder_link" />
        <child link="arm_link"/>
        <origin xyz="0 0 -0.001" rpy="0 ${pi/2} ${-pi/2}"/>
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="1.0" lower="-2.879793" upper="2.879793" />
    </joint>

    <joint name="joint3" type="revolute">
        <parent link="arm_link" />
        <child link="elbow_link"/>
        <origin xyz="-0.1104 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="1.0" lower="-2.879793" upper="2.879793" />
    </joint>

    <joint name="joint4" type="revolute">
        <parent link="elbow_link" />
        <child link="forearm_link"/>
        <origin xyz="-0.096 0 0.06062" rpy="0 0 ${-pi/2}"/>
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="1.0" lower="-2.879793" upper="2.879793" />
    </joint>

    <joint name="joint5" type="revolute">
        <parent link="forearm_link" />
        <child link="wrist_link"/>
        <origin xyz="0 -0.07318 0" rpy="${pi/2} ${-pi/2} 0"/>
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="1.0" lower="-2.879793" upper="2.879793" />
    </joint>

    <joint name="joint6" type="revolute">
        <parent link="wrist_link" />
        <child link="hand_link"/>
        <origin xyz="0 0.0456 0" rpy="${-pi/2} 0 0"/>
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="1.0" lower="-3.05" upper="3.05" />
    </joint>

    <joint name="hand_tool_joint" type="fixed">
        <parent link="hand_link" />
        <child link="tool_link"/>
        <origin xyz="0 0 0.012" rpy="0 0 0"/>
    </joint>
</robot>